# Copy to .env and fill in. Never commit real keys (req. 7).
SETLISTFM_API_KEY=
YOUTUBE_API_KEY=
TMDB_API_KEY=
SLACK_WEBHOOK_URL=
# Per-module enable/disable and markets (req. 7). Empty = all modules.
RUM_ENABLED_MODULES=
RUM_MODULE_MARKETS={"charts": ["DE", "JP"]}
# Charts access route - confirm ToS before enabling in production (req. 12).
#RUM_CHARTS_URL_TEMPLATE=https://spotifycharts.com/regional/{market}/weekly/latest/download
RUM_ALERT_MIN_CONFIDENCE=0.9
RUM_DATABASE_URL=sqlite:///rum.db
RUM_EVIDENCE_DIR=evidence
RUM_CONTACT_EMAIL=repertoire-monitor@example.org
RUM_RATE_LIMIT_SECONDS=2.0
RUM_LEVEL2_THRESHOLD=0.92
RUM_LEVEL3_THRESHOLD=0.80
RUM_EVIDENCE_RETENTION_YEARS=5
